dataset_path: json
test_split: test
output_type: generate_until

doc_to_visual: !function utils.audiomarathon_doc_to_audio
doc_to_messages: !function utils.audiomarathon_doc_to_messages_asr
doc_to_text: !function utils.audiomarathon_doc_to_text_asr
doc_to_target: "transcript"

generation_kwargs:
  max_new_tokens: 1100
  temperature: 0
  top_p: 1.0
  num_beams: 1
  do_sample: false

process_results: !function utils.audiomarathon_process_results_asr
metric_list:
  - metric: wer
    aggregation: !function utils.audiomarathon_aggregate_wer
    higher_is_better: false
  - metric: word_accuracy
    aggregation: !function utils.audiomarathon_aggregate_word_accuracy
    higher_is_better: true
  - metric: audiomarathon_score
    aggregation: !function utils.audiomarathon_aggregate_score_asr
    higher_is_better: true

lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: ""

metadata:
  version: 1.0
