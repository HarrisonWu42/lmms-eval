dataset_path: json
test_split: test
output_type: generate_until

doc_to_visual: !function utils.audiomarathon_doc_to_audio
doc_to_messages: !function utils.audiomarathon_doc_to_messages_summary
doc_to_text: !function utils.audiomarathon_doc_to_text_summary
doc_to_target: "reference_summary"

generation_kwargs:
  max_new_tokens: 1024
  temperature: 0
  top_p: 1.0
  num_beams: 1
  do_sample: false

process_results: !function utils.audiomarathon_process_results_summary
metric_list:
  - metric: audiomarathon_summary_char_f1
    aggregation: !function utils.audiomarathon_aggregate_summary_char_f1
    higher_is_better: true

lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: ""

metadata:
  version: 0.0
